# Local development only. Copy to backend/.env. Do not put production secrets here.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://quantivo:quantivo@localhost:5433/quantivo
SECRET_KEY=development-only-change-this-key-before-use
AUTH_PROVIDER=dev_mock
LIVE_TRADING_ENABLED=false
DEV_ACTIVATION_ENABLED=true
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_REQUEST_LIMIT=5
OTP_REQUEST_WINDOW_SECONDS=900
OTP_MAX_ATTEMPTS=5
LOG_LEVEL=INFO
# Call clocks are saved from Admin. Starting values: Intraday and BTST 30 minutes, short term 30 days, long term 30 days.

# Worker only. Leave these unset until this worker has its own Telegram login.
# Do not copy api_id, api_hash, or a session file from another project.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_PATH=

# Optional. Last traded price for NSE cash calls. Leave unset to show no LTP.
# An admin saves the app id, app secret, PIN, client id, and TOTP key on Admin configuration.
# Those values are written here, not into the database. Do not commit a real secret, PIN, or token.
# The access token ends at 06:30 IST. The server signs in again with the TOTP key after that.
# FYERS_APP_ID=
# FYERS_APP_SECRET=
# FYERS_PIN=
# FYERS_CLIENT_ID=
# FYERS_TOTP_SECRET=
# FYERS_REDIRECT_URI=
# FYERS_ACCESS_TOKEN=
# FYERS_REFRESH_TOKEN=

# Optional. One Kite Connect app for trader sign-in. An admin saves these on Admin configuration.
# The api secret stays in this file. Each trader's access token stays in .quantivo/secrets/zerodha.
# A session lasts until 06:00 IST and is not refreshed. Do not commit a real key, secret, or token.
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_REDIRECT_URI=
